# MongoDB Atlas - cole sua connection string aqui
# Formato: mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/keumotos?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/keumotos?retryWrites=true&w=majority

# Secret para sessões (gere com: openssl rand -base64 32)
AUTH_SECRET=

# URL pública da aplicação (em produção)
NEXT_PUBLIC_APP_URL=http://localhost:3000
